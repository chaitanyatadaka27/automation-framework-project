<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="UI Suite" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="com.automation.framework.listeners.TestListener"/>
        <listener class-name="com.automation.framework.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="com.automation.framework.ui.LoginTest"/>
        </classes>
    </test>

    <test name="Bank Tests">
        <classes>
            <class name="com.automation.framework.ui.BankAccountTest"/>
        </classes>
    </test>

    <test name="Logout Tests">
        <classes>
            <class name="com.automation.framework.ui.LogoutTest"/>
        </classes>
    </test>

</suite>